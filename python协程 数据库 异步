import aiomysql
from loguru import logger


class AsyncPostSQL:

    def __init__(self):
        self.pool = None

    async def connect(self):
        self.pool = await aiomysql.create_pool(
            host="10.240.35.92",
            port=3306,
            user="root",
            password="Autel123",
            db="piltest",
            maxsize=1,  #1每个协程创建一个
            minsize=1,  #1每个协程创建一个
            autocommit=True
        )

    async def get_path_for_id(self, id):
        try:
            async with self.pool.acquire() as conn:
                async with conn.cursor() as cur:
                    sql = "SELECT id,case_name FROM piltest_case_report_detail WHERE case_plan_id = {}".format(id)
                    await cur.execute(sql)
                    return await cur.fetchall()
        except aiomysql.DatabaseError as e:
            logger.debug(f"Query error: {e}")

    async def insert_data(self, table, data):
        try:
            async with self.pool.acquire() as conn:
                async with conn.cursor() as cur:
                    cols = ','.join(data.keys())
                    vals = ','.join(['%s'] * len(data))
                    sql = f'INSERT INTO {table} ({cols}) VALUES ({vals});'
                    try:
                        await cur.execute(sql, list(data.values()))
                        last_insert_id = cur.lastrowid
                        return last_insert_id
                    except Exception as e:
                        logger.debug(f'Insert failed: {e}')
        except aiomysql.DatabaseError as e:
            logger.debug(f"Insert failed: {e}")

    async def update_data(self, table_name, column_value_pairs, condition):
        try:
            async with self.pool.acquire() as conn:
                async with conn.cursor() as cur:
                    set_clause = ",".join([f"{c}=%s" for c in column_value_pairs])
                    where_clause = "AND ".join([f"{c}=%s" for c in condition])
                    values = list(column_value_pairs.values()) + list(condition.values())
                    sql = f"UPDATE {table_name} SET {set_clause} WHERE {where_clause}"
                    await cur.execute(sql, values)
                    affected_rows = cur.rowcount
                    return affected_rows
        except aiomysql.DatabaseError as e:
            logger.debug(f"Update failed: {e}")

    async def query_fetch_all(self, table, columns, condition=None, desc=False):
        try:
            async with self.pool.acquire() as conn:
                async with conn.cursor() as cur:
                    cols = ','.join(columns)
                    where = ' AND '.join([f'{k}=%s' for k in condition]) if condition else ''
                    sql = f'SELECT {cols} FROM {table} WHERE {where}'
                    if desc:
                        sql += ' ORDER BY update_time DESC'
                    values = list(condition.values()) if condition else None
                    await cur.execute(sql, values)
                    result = await cur.fetchall()
                    return result
        except aiomysql.DatabaseError as e:
            logger.debug(f"Query error: {e}")
