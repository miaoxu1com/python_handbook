import asyncio
import hashlib
import os
import time

from piltest.util.asyncio_post_sql_info import AsyncPostSQL


def calculate_md5(file_path):
    md5_hash = hashlib.md5()
    with open(file_path, "rb") as file:
        for chunk in iter(lambda: file.read(4096), b""):
            md5_hash.update(chunk)
    return md5_hash.hexdigest()


def get_file_size(file_path):
    file_size = os.stat(file_path).st_size
    return file_size


def convert_to_mb(file_size):
    size_in_mb = file_size / (1024 * 1024)
    unit = "MB"
    size_in_mb = str(round(size_in_mb, 2)) + unit
    return size_in_mb


def get_file_name(file_path):
    file_name = os.path.basename(file_path)
    return file_name


def get_file_paths(directory):
    file_paths = []
    for filename in os.listdir(directory):
        file_path = os.path.join(directory, filename)
        if os.path.isfile(file_path):
            file_paths.append((file_path,))
    return file_paths


async def save_file_info(pool, file_path):
    # 计算MD5和大小
    md5 = calculate_md5(file_path)
    size = get_file_size(file_path)
    table_name = "piltest_file_info"
    col = ["id", "file_path", "md5", "file_size", "flag"]
    cond = {"md5": md5}
    res = await pool.query_fetch_all(table_name, col, cond)

    if bool(len(res)) is False:
        table_name = "piltest_file_info"
        col = {
            "file_path": file_path,
            "md5": md5,
            "file_size": size
        }
        await pool.insert_data(table_name, col)


file_id_list = []


async def main():
    db = AsyncPostSQL()
    await db.connect()
    table_name = "piltest_file_info"
    col = ["id", "file_path", "md5", "file_size", "create_time", "flag"]
    cond = {"flag": 1}
    file_list = await db.query_fetch_all(table_name, col, cond)
    tasks = [save_file_info(db, f[1]) for f in file_list]
    await asyncio.gather(*tasks)


if __name__ == "__main__":
    start_time = time.time()
    asyncio.run(main())
    end_time = time.time()

    execution_time = end_time - start_time
    print(f"执行时间：{execution_time} 秒")
