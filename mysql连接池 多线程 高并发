class post_sql_info:

    def one_insert(self, table: str, data: dict) -> int:
        """单条插入"""
        try:
            conn = pool.connection()
            cursor = conn.cursor()
            cols = ','.join(data.keys())
            vals = ','.join(['%s'] * len(data))
            sql = f'INSERT INTO {table} ({cols}) VALUES ({vals});'
            cursor.execute(sql, list(data.values()))
            insert_id = cursor.lastrowid
            logger.info(f"{insert_id}==============")
            conn.commit()
            cursor.close()
            conn.close()
            return insert_id
        except Exception as e:
            logger.debug(f'Insert failed: {e}')

    def query_fetch_all(self, table_name: str, columns: list[str], condition: dict = None, desc: bool = False) -> Tuple[
        tuple]:
        """查询记录"""
        try:
            conn = pool.connection()
            cursor = conn.cursor()
            select_clause = ", ".join(columns)
            where_clause = ""
            values = []
            if condition:
                where_clause = " WHERE " + " AND ".join([f"{column} = %s" for column in condition.keys()])
                values = list(condition.values())
            sql = f"SELECT {select_clause} FROM {table_name}{where_clause}"
            if desc is True:
                sql = sql + " ORDER BY update_time DESC"
            cursor.execute(sql, values)
            result = cursor.fetchall()
            cursor.close()
            conn.close()
            return result
        except Exception as e:
            logger.debug(f"Query error: {e}")

    def executemany_insert(self, table: str, data_list: list):
        """批量插入数据"""

        try:
            conn = pool.connection()
            cursor = conn.cursor()
            cols = ','.join(data_list[0].keys())
            values = [tuple(d.values()) for d in data_list]
            placeholders = ','.join(['%s'] * len(data_list))
            sql = f'INSERT INTO {table} ({cols}) VALUES {placeholders}'
            cursor.execute(sql, values)
            cursor.close()
            conn.close()
            return cursor.lastrowid
        except Exception as e:
            logger.debug(f'Insert failed: {e}')

    def update_data(self, table_name: str, column_value_pairs: dict, condition: dict):
        """更新数据"""

        try:
            conn = pool.connection()
            cursor = conn.cursor()
            set_clause = ", ".join([f"{column} = %s" for column in column_value_pairs.keys()])
            where_clause = " AND ".join([f"{column} = %s" for column in condition.keys()])
            values = list(column_value_pairs.values()) + list(condition.values())
            sql = f"UPDATE {table_name} SET {set_clause} WHERE {where_clause}"
            cursor.execute(sql, values)
            cursor.close()
            conn.close()
        except Exception as e:
            logger.debug(f'Update failed: {e}')


from concurrent.futures import ThreadPoolExecutor

from loguru import logger


def multi_thread_doit(tar_get_name, *args):
    # 创建包含指定线程数的线程池
    with ThreadPoolExecutor(max_workers=12) as executor:

        # 提交目标函数及参数到线程池执行
        tasks = []
        for param in args[0]:
            tasks.append(executor.submit(tar_get_name, *param))
        # 等待所有任务完成
        for future in tasks:
            res = future.result()
            if res is None:
                continue
            else:
                logger.debug(f"{res}")

