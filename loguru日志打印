import sys

from loguru import logger

# 只打印Debug信息到log.log文件，控制台输出INFO信息
def debug_only(record):
    return record["level"].name == "DEBUG"


log_config = {
    "mode": "w",
    "retention": "3 days",
    "rotation": "3 GB",
    "encoding": "utf-8",
    "filter": debug_only
}

log_path = "../../log/debug/log.log"
# 移除默认的日志处理器
logger.remove()
logger.add(sys.stdout, level='INFO')
logger.add(log_path, **log_config)
