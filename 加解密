import base64
import json

from Crypto.Cipher import PKCS1_OAEP
from Crypto.Hash import SHA256
from Crypto.PublicKey import RSA


with open('key.rsa.pub', 'r') as pub_file:
    pub_key = RSA.importKey(pub_file.read())

with open('key.rsa', 'r') as pri_file:
    pri_key = RSA.importKey(pri_file.read())


def encryption(text: str, public_key: bytes):
    print("加密字符串:", text)
    # 构建公钥对象
    cipher_public = PKCS1_OAEP.new(public_key, hashAlgo=SHA256)
    # 加密（bytes）
    text_encrypted = cipher_public.encrypt(text.encode("utf-8"))
    # base64编码，并转为字符串
    text_encrypted_base64 = base64.b64encode(text_encrypted).decode()
    return text_encrypted_base64


def decryption(text_encrypted_base64: str, private_key: bytes):
    # 字符串指定编码（转为bytes）
    text_encrypted_base64 = text_encrypted_base64.encode('utf-8')
    # base64解码
    text_encrypted = base64.b64decode(text_encrypted_base64)
    # 构建私钥对象
    cipher_private = PKCS1_OAEP.new(private_key)
    # 解密（bytes）
    text_decrypted = cipher_private.decrypt(text_encrypted)
    # 解码为字符串
    text_decrypted = text_decrypted.decode()
    return text_decrypted


