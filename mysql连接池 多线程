配合线程池时

from concurrent.futures import ThreadPoolExecutor

from loguru import logger


def multi_thread_doit(tar_get_name, *args):
    # 创建包含指定线程数的线程池
    with ThreadPoolExecutor(max_workers=12) as executor:

        # 提交目标函数及参数到线程池执行
        tasks = []
        for param in args[0]:
            tasks.append(executor.submit(tar_get_name, *param))
        # 等待所有任务完成
        for future in tasks:
            res = future.result()
            if res is None:
                continue
            else:
                logger.debug(f"{res}")

